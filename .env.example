# Supabase Configuration (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=invoices

# Google AI Studio Free Tier API Key (https://aistudio.google.com/apikey)
# Supports GEMINI_API_KEY (or alias GOOGLE_API_KEY). Can also be set inside /settings#ai-setup per user account.
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-latest
GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_COOLDOWN_SECONDS=300
GEMINI_MAX_FILE_SIZE_BYTES=52428800

# Cron maintenance security secret (set on Vercel & optional GitHub Actions)
CRON_SECRET=change-this-to-a-long-random-secret
